 154:src/KSemaphore.cpp **** int KSemaphore::close()
 155:src/KSemaphore.cpp **** {
 156:src/KSemaphore.cpp ****     if (closed) return -1;
 157:src/KSemaphore.cpp ****     closed = true;
 158:src/KSemaphore.cpp ****     value=0;
 159:src/KSemaphore.cpp ****     while (waitHead != nullptr)
 160:src/KSemaphore.cpp ****     {
 161:src/KSemaphore.cpp ****         KThread* thread = getWaitQueue();
 162:src/KSemaphore.cpp ****         thread->waitResult=-1;
 163:src/KSemaphore.cpp ****         thread->waitUnits=0;
 164:src/KSemaphore.cpp ****         int result = KThread::unblock(thread);
 165:src/KSemaphore.cpp ****         if (result<0) return -2;
 166:src/KSemaphore.cpp ****     }
 167:src/KSemaphore.cpp ****     return 0;
 168:src/KSemaphore.cpp **** }
