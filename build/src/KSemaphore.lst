 100:src/KSemaphore.cpp **** int KSemaphore::waitN(unsigned n)
 101:src/KSemaphore.cpp **** {
 102:src/KSemaphore.cpp ****     if (closed) return -1;
 103:src/KSemaphore.cpp ****     if (n==0) return 0;
 104:src/KSemaphore.cpp ****     if ((unsigned)value>=n)
 105:src/KSemaphore.cpp ****     {
 106:src/KSemaphore.cpp ****         value-=(int)n;
 107:src/KSemaphore.cpp ****         return 0;
 108:src/KSemaphore.cpp ****     }
 109:src/KSemaphore.cpp ****     KThread* current = KThread::running;
 110:src/KSemaphore.cpp ****     if (current == nullptr || current->status != KThread::RUNNING) return -2;
 111:src/KSemaphore.cpp ****     current->waitUnits = n;
 112:src/KSemaphore.cpp ****     current->waitResult = 0;
 113:src/KSemaphore.cpp ****     putWaitQueue(current);
 114:src/KSemaphore.cpp ****     int result = KThread::block();
 115:src/KSemaphore.cpp ****     if (result<0) return result;
 116:src/KSemaphore.cpp ****     result = current->waitResult;
 117:src/KSemaphore.cpp ****     current->waitUnits=0;
 118:src/KSemaphore.cpp ****     current->waitResult= 0;
 119:src/KSemaphore.cpp ****     return result;
 120:src/KSemaphore.cpp **** }
 121:src/KSemaphore.cpp **** 
 122:src/KSemaphore.cpp **** int KSemaphore::signalN(unsigned n)
 123:src/KSemaphore.cpp **** {
 124:src/KSemaphore.cpp ****     if (closed) return -1;
 125:src/KSemaphore.cpp ****     if (n==0) return 0;
 126:src/KSemaphore.cpp ****     //ovde ubaciti zastitu od prevelikog n ako treba
 127:src/KSemaphore.cpp ****     value+=(int)n;
 128:src/KSemaphore.cpp ****     while (waitHead!=nullptr)
 129:src/KSemaphore.cpp ****     {
 130:src/KSemaphore.cpp ****         KThread* thread=waitHead;
 131:src/KSemaphore.cpp ****         if (thread->waitUnits>(unsigned)value)
 132:src/KSemaphore.cpp ****         {
 133:src/KSemaphore.cpp ****             break;
 134:src/KSemaphore.cpp ****         }
 135:src/KSemaphore.cpp ****         value-=(int)thread->waitUnits;
 136:src/KSemaphore.cpp ****         thread = getWaitQueue();
 137:src/KSemaphore.cpp ****         thread->waitResult = 0;
 138:src/KSemaphore.cpp ****         int result = KThread::unblock(thread);
GAS LISTING /tmp/ccPaHA63.s 			page 5


 139:src/KSemaphore.cpp ****         if (result<0) return -3;
 140:src/KSemaphore.cpp ****     }
 141:src/KSemaphore.cpp ****     return 0;
 142:src/KSemaphore.cpp **** }
 143:src/KSemaphore.cpp **** 
 144:src/KSemaphore.cpp **** int KSemaphore::wait()
 145:src/KSemaphore.cpp **** {
